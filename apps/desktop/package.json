{
  "name": "@battlebeasts/desktop",
  "version": "0.0.13",
  "private": true,
  "author": "Mage Trials",
  "description": "Mage Trials desktop launcher",
  "copyright": "Copyright © Mage Trials",
  "main": "main.cjs",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build:renderer": "pnpm --filter @battlebeasts/web run build:electron && node ./scripts/copy-renderer.mjs",
    "pack:content": "node ./scripts/pack-content.mjs",
    "publish:content": "node ./scripts/publish-content.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.battlebeasts.desktop",
    "productName": "Mage Trials",
    "copyright": "Copyright © Mage Trials",
    "directories": {
      "output": "release-v5"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "launcher/**/*",
      "build/icon.png"
    ],
    "asar": false,
    "icon": "build/icon.png",
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mage Trials",
      "uninstallDisplayName": "Mage Trials",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "differentialPackage": false,
      "artifactName": "MageTrials-Launcher-${version}.exe"
    },
    "protocols": {
      "name": "Mage Trials",
      "schemes": ["battlebeasts"]
    }
  }
}
