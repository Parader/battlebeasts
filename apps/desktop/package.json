{
  "name": "@battlebeasts/desktop",
  "version": "0.0.3",
  "private": true,
  "description": "Mage Trials desktop launcher (Electron) — game files download on first run",
  "main": "main.cjs",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build:renderer": "pnpm --filter @battlebeasts/web run build:electron && node ./scripts/copy-renderer.mjs",
    "pack:content": "node ./scripts/pack-content.mjs",
    "publish:content": "node ./scripts/publish-content.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.battlebeasts.desktop",
    "productName": "Mage Trials",
    "directories": {
      "output": "release-v5"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "launcher/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "MageTrials-Launcher-${version}.exe"
    },
    "protocols": {
      "name": "Mage Trials",
      "schemes": ["battlebeasts"]
    }
  }
}
