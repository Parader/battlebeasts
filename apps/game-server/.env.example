PORT=2567
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key — required for ranked LP/tier persistence (anon key cannot write player_ratings).
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_PASSWORD=your_db_password
# Set to false (default behavior) — guests are no longer accepted
ALLOW_GUESTS=false
