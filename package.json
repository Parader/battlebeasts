{
  "name": "battlebeasts",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @battlebeasts/web --filter @battlebeasts/game-server run dev",
    "dev:web": "pnpm --filter @battlebeasts/web dev",
    "dev:server": "pnpm --filter @battlebeasts/game-server dev",
    "dev:editor": "pnpm --filter @battlebeasts/editor dev",
    "dev:vfx": "pnpm --filter @battlebeasts/vfx-lab dev",
    "dev:desktop": "pnpm --filter @battlebeasts/desktop dev",
    "dist:desktop": "pnpm --filter @battlebeasts/desktop dist",
    "publish:launcher": "node ./apps/desktop/scripts/publish-launcher.mjs",
    "dist:launcher": "pnpm dist:desktop && node ./apps/desktop/scripts/publish-launcher.mjs",
    "prod:up": "docker compose --env-file compose.env up -d",
    "prod:down": "docker compose --env-file compose.env down",
    "publish:game": "node ./apps/desktop/scripts/publish-content.mjs",
    "release": "docker compose --env-file compose.env up -d --build && node ./apps/desktop/scripts/publish-content.mjs",
    "deploy:game": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-game-server.ps1",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @battlebeasts/shared build",
    "gen:props": "node scripts/gen-prop-manifest.mjs",
    "gen:props:force": "node scripts/gen-prop-manifest.mjs --force",
    "gen:maps": "node scripts/gen-map-index.mjs",
    "export:skins": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/export-skins.ps1",
    "export:skins:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/export-skins.ps1 -Install",
    "workbench:ybot": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/add-ybot-to-bind.ps1",
    "workbench:idle": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bind-idle.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
