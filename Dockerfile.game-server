# Build from repo root: docker build -f apps/game-server/Dockerfile .
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/game-server/package.json apps/game-server/

RUN pnpm install --filter @battlebeasts/game-server... --frozen-lockfile

COPY packages/shared packages/shared
COPY apps/game-server apps/game-server

RUN pnpm --filter @battlebeasts/shared build \
 && pnpm --filter @battlebeasts/game-server build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=2567
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/game-server/package.json apps/game-server/

RUN pnpm install --filter @battlebeasts/game-server... --prod --frozen-lockfile

COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/apps/game-server/dist apps/game-server/dist
RUN node -e "const fs=require('fs'); const p='packages/shared/package.json'; const j=JSON.parse(fs.readFileSync(p,'utf8')); j.main='./dist/index.js'; j.types='./dist/index.d.ts'; j.exports={'.':{types:'./dist/index.d.ts',import:'./dist/index.js',default:'./dist/index.js'}}; fs.writeFileSync(p, JSON.stringify(j,null,2));"

WORKDIR /app/apps/game-server
EXPOSE 2567
CMD ["node", "dist/index.js"]
